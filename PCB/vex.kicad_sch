		(uuid "10b807cc-b6b8-426a-82bd-2c3e0c23d20b")
	)
	(text "VBUSM divider: 5V -> 2.5V,\nso the hub sees host attach/detach."
		(exclude_from_sim no)
		(at 60.96 142.24 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "18e0bf4a-5786-4a2b-9956-04df86ba971f")
	)
	(text "Gang A (F1/Q2): ports 1-4.  Gang B (F2/Q3): ports 5-7.\nOVCJ1/OVCJ5 sense the fuse outputs (datasheet Fig. 8).\nPWRJ low turns both PMOS on; 5V pull-up keeps them off at reset."
		(exclude_from_sim no)
		(at 308.61 99.06 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "3a370503-a90a-4fda-b56d-56500a25cb38")
	)
