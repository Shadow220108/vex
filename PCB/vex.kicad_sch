	(text "C12/C13 DNP: FE2.1 has internal load caps; fit only if 12MHz is off-frequency.\nTESTJ floating = no EEPROM. LED1-7 floating = 7 ports, all removable."
		(exclude_from_sim no)
		(at 158.75 203.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
